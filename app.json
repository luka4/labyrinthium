{
  "expo": {
    "name": "Labyrinthium",
    "slug": "labyrinthium",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.labyrinthium.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0a08",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.labyrinthium.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-dev-client",
      "expo-asset",
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ],
    "owner": "luka4",
    "scheme": "labyrinthium",
    "backgroundColor": "#0b0a08"
  }
}
